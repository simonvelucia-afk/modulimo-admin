# ── Identite ─────────────────────────────────────────────────────────
INSTANCE_ID=modulimo-central
INSTANCE_NAME=Modulimo Central

# ── Adresse ──────────────────────────────────────────────────────────
# URL par laquelle l'interface d'administration ET les instances
# CoHabitat joignent la centrale. La meme valeur doit etre utilisee
# partout, sinon l'authentification rejette les redirections.
SITE_URL=https://central.modulimo.lan
SITE_HOST=central.modulimo.lan
# Ports differents de CoHabitat si les deux tournent sur la meme machine.
HTTP_PORT=8080
HTTPS_PORT=8443

POSTGRES_DB=modulimo

# ── Comptes ──────────────────────────────────────────────────────────
# La centrale ne s'ouvre pas a l'inscription libre : les comptes sont
# crees par ./modulimo admin <courriel>.
DISABLE_SIGNUP=true
MAILER_AUTOCONFIRM=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=admin@modulimo.lan

# ── Courriels sortants (Resend) ──────────────────────────────────────
# Seule dependance a un service externe, et elle est facultative : sans
# cle, la fonction send-email refuse proprement et le reste fonctionne.
# RESEND_KEY=
# RESEND_FROM=Modulimo <no-reply@modulimo.com>
# LEADS_NOTIFY_TO=

# ── Synchronisation finance ──────────────────────────────────────────
# Cles de service des instances CoHabitat interrogees par finance-sync,
# au format attendu par la fonction (voir supabase/functions/finance-sync).
# FINANCE_SYNC_COHABITAT_KEYS=

# ── Ressources locales ───────────────────────────────────────────────
# true : librairies servies depuis vendor/ (obligatoire en reseau ferme).
OFFLINE_ASSETS=true

# ── Secrets ──────────────────────────────────────────────────────────
# Ne pas remplir a la main : ./modulimo init genere .env.secrets.
